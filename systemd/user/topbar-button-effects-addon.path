[Unit]
Description=Watch the Quickshell top bar button animation targets

[Path]
PathChanged=%h/.config/hypr/scripts/quickshell/Main.qml
PathChanged=%h/.config/hypr/scripts/quickshell/TopBar.qml
PathChanged=%h/.config/hypr/scripts/quickshell/settings/SettingsPopup.qml
PathChanged=%h/.config/hypr/scripts/quickshell/settings/AddonSettingsPage.qml
PathChanged=%h/.config/hypr/settings.json
Unit=topbar-button-effects-addon.service

[Install]
WantedBy=default.target
